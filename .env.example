# انسخ هذا الملف إلى .env واملأ القيم قبل التشغيل على السيرفر
# Copy this file to .env and fill in the values before running in production.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Never leave this on in production.
DJANGO_DEBUG=False

# Comma-separated hostnames/IPs this server answers on. A scheme or trailing
# slash is stripped automatically. On Render this may be left empty: the
# RENDER_EXTERNAL_HOSTNAME the platform provides is trusted automatically.
DJANGO_ALLOWED_HOSTS=hr.example.local,10.0.0.15

# Comma-separated origins allowed to submit forms. A missing scheme is filled
# in from DJANGO_SECURE_SSL.
DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.example.local

# Turn on once the site is served over HTTPS: enables Secure cookies, HSTS and
# the HTTP-to-HTTPS redirect.
DJANGO_SECURE_SSL=False

# Leave unset to use the local SQLite file.
# DATABASE_URL=postgres://user:password@localhost:5432/aseer
# DJANGO_DB_SSL_REQUIRE=False

# Failed logins per username+IP before a temporary lockout, and its duration.
DJANGO_LOGIN_ATTEMPT_LIMIT=10
DJANGO_LOGIN_ATTEMPT_TIMEOUT=900
