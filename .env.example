# ==========================================================
#  إعدادات نظام إدارة الموارد البشرية — تجمع عسير الصحي
# ==========================================================
#  انسخ هذا الملف باسم  .env  ثم عدّل القيم.
#  لا تشارك ملف .env مع أحد ولا ترفعه على أي مستودع.
# ==========================================================


# ----------------------------------------------------------
#  1) المفتاح السري  (إلزامي)
# ----------------------------------------------------------
#  مفتاح عشوائي طويل يوقّع به النظام جلسات المستخدمين.
#  ولّده بتشغيل:  python generate_key.py
#  لا تستخدم المفتاح نفسه في أكثر من تركيب.
#  تغييره لاحقاً يُخرج كل المستخدمين ويلزمهم الدخول من جديد.

DJANGO_SECRET_KEY=ضع-هنا-المفتاح-المولَّد


# ----------------------------------------------------------
#  2) عناوين الخادم المسموح بها  (إلزامي)
# ----------------------------------------------------------
#  أسماء أو عناوين IP التي سيُفتح بها النظام، مفصولة بفاصلة.
#  اكتب الاسم فقط: بلا http:// وبلا / في النهاية.
#  أي عنوان غير مذكور هنا سيُرفض برد 400 — وهذه حماية مقصودة.
#
#  مثال لخادم داخلي:

DJANGO_ALLOWED_HOSTS=10.0.0.15,hr.aseer.local


# ----------------------------------------------------------
#  3) وضع التطوير  (اتركه فارغاً في التشغيل الحقيقي)
# ----------------------------------------------------------
#  True يعرض تفاصيل الأخطاء كاملة لأي زائر — بما فيها إعدادات
#  الخادم. لا تفعّله على خادم يستخدمه موظفون.

# DJANGO_DEBUG=True


# ----------------------------------------------------------
#  4) التشفير HTTPS
# ----------------------------------------------------------
#  فعّله True فقط بعد تركيب شهادة SSL على الخادم.
#  تفعيله بدون شهادة يمنع تسجيل الدخول تماماً.
#
#  ملاحظة أمنية مهمة:
#  ما دام False فبيانات الدخول تمرّ على الشبكة الداخلية بلا تشفير.
#  مقبول داخل شبكة معزولة موثوقة، لكن HTTPS أفضل دائماً.

DJANGO_SECURE_SSL=False


# ----------------------------------------------------------
#  5) العناوين الموثوقة للنماذج  (عند تفعيل HTTPS)
# ----------------------------------------------------------
#  اكتبها مع البادئة https:// — تُترك فارغة مع HTTP.

# DJANGO_CSRF_TRUSTED_ORIGINS=https://hr.aseer.local


# ----------------------------------------------------------
#  6) قاعدة البيانات
# ----------------------------------------------------------
#  اتركه فارغاً لاستخدام SQLite (ملف db.sqlite3 داخل المجلد).
#  SQLite كافية تماماً حتى بضعة آلاف موظف وعشرات المستخدمين.
#
#  للانتقال إلى PostgreSQL لاحقاً:
# DATABASE_URL=postgres://اسم_المستخدم:كلمة_المرور@127.0.0.1:5432/اسم_القاعدة


# ----------------------------------------------------------
#  7) حماية من تخمين كلمات المرور
# ----------------------------------------------------------
#  عدد المحاولات الفاشلة قبل الإيقاف المؤقت، ومدة الإيقاف بالثواني.

DJANGO_LOGIN_ATTEMPT_LIMIT=10
DJANGO_LOGIN_ATTEMPT_TIMEOUT=900
